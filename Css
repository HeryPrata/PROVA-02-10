.hero {
  background: #0f4c9c;
  color: #fff;
  padding: 40px 20px;
  display: flex;
  flex-wrap: wrap; /* Faz o conteúdo ir para baixo no celular automaticamente */
  align-items: center;
  justify-content: center;
  gap: 30px;
  font-family: sans-serif;
}

.hero h1 {
  font-weight: 300;
  margin-bottom: 20px;
}

.btn {
  background: #fff;
  color: #0f4c9c;
  padding: 12px 24px;
  border-radius: 25px;
  text-decoration: none;
  font-weight: bold;
  display: inline-block;
}

.hero img {
  width: 100%;
  max-width: 450px;
  border-radius: 20px;
}
